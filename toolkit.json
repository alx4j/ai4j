{
  "schemaVersion": 1,
  "toolkit": {
    "id": "ai4j",
    "declarationId": "ai4j",
    "version": "1.0.0",
    "displayName": "AI4J Default Toolkit",
    "description": "Practical repository review guidance and target-native integrations.",
    "compatibility": {
      "minimumCli": "1.0.0"
    }
  },
  "assets": [
    {
      "id": "repository-review",
      "type": "skill",
      "path": "plugins/ai4j-review/skills/repository-review",
      "ownership": "package",
      "dependencies": ["review-checklist", "check-diff"]
    },
    {
      "id": "repository-reviewer",
      "type": "agent",
      "ownership": "package",
      "variants": [
        {
          "id": "claude",
          "path": "plugins/ai4j-reviewer-claude/agents/repository-reviewer.md",
          "targets": ["claude"],
          "hosts": ["darwin-arm64", "windows-amd64"]
        },
        {
          "id": "codex",
          "path": "plugins/ai4j-reviewer-codex/agents/repository-reviewer.toml",
          "targets": ["codex"],
          "hosts": ["darwin-arm64", "windows-amd64"]
        }
      ]
    },
    {
      "id": "ai4j-rules",
      "type": "instruction",
      "path": "toolkit/rules/ai4j.md",
      "ownership": "configuration"
    },
    {
      "id": "review-checklist",
      "type": "reference",
      "path": "plugins/ai4j-review/skills/repository-review/references/checklist.md",
      "ownership": "package"
    },
    {
      "id": "check-diff",
      "type": "script",
      "ownership": "package",
      "variants": [
        {
          "id": "darwin-arm64",
          "path": "plugins/ai4j-review/skills/repository-review/scripts/check-diff.sh",
          "targets": ["claude", "codex"],
          "hosts": ["darwin-arm64"],
          "executable": {
            "command": "plugins/ai4j-review/skills/repository-review/scripts/check-diff.sh",
            "dependency": "optional"
          }
        },
        {
          "id": "windows-amd64",
          "path": "plugins/ai4j-review/skills/repository-review/scripts/check-diff.ps1",
          "targets": ["claude", "codex"],
          "hosts": ["windows-amd64"],
          "executable": {
            "command": "plugins/ai4j-review/skills/repository-review/scripts/check-diff.ps1",
            "dependency": "optional"
          }
        }
      ]
    },
    {
      "id": "claude-tools",
      "type": "mcp",
      "path": "plugins/ai4j-tools/.mcp.json",
      "ownership": "package",
      "executable": {
        "command": "claude",
        "args": ["mcp", "serve"],
        "dependency": "required"
      }
    }
  ],
  "bundles": [
    {
      "id": "review",
      "packages": ["ai4j-review", "ai4j-reviewer"],
      "assets": ["ai4j-rules"]
    },
    {
      "id": "tools",
      "packages": ["ai4j-tools"]
    },
    {
      "id": "default",
      "bundles": ["review", "tools"]
    }
  ],
  "targets": {
    "claude": {
      "packages": [
        {
          "id": "ai4j-review",
          "path": "plugins/ai4j-review",
          "assets": ["repository-review", "review-checklist", "check-diff"]
        },
        {
          "id": "ai4j-reviewer",
          "path": "plugins/ai4j-reviewer-claude",
          "assets": ["repository-reviewer"]
        },
        {
          "id": "ai4j-tools",
          "path": "plugins/ai4j-tools",
          "assets": ["claude-tools"]
        }
      ]
    },
    "codex": {
      "packages": [
        {
          "id": "ai4j-review",
          "path": "plugins/ai4j-review",
          "assets": ["repository-review", "review-checklist", "check-diff"]
        },
        {
          "id": "ai4j-reviewer",
          "path": "plugins/ai4j-reviewer-codex",
          "assets": ["repository-reviewer"]
        },
        {
          "id": "ai4j-tools",
          "path": "plugins/ai4j-tools",
          "assets": ["claude-tools"]
        }
      ]
    }
  }
}
