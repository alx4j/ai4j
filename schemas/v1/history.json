{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/alx4j/ai4j/schemas/v1/history.json","title":"AI4J schema v1 history response","$defs":{"entry":{"type":"object","required":["operationId","operation","timestamp","restorable"],"properties":{"operationId":{"type":"string","pattern":"^[a-z0-9][a-z0-9_-]{0,63}$"},"operation":{"enum":["install","update","sync","rollback","uninstall"]},"timestamp":{"type":"string","format":"date-time"},"restorable":{"type":"boolean"}},"additionalProperties":false},"data":{"type":"object","required":["installationId","entries"],"properties":{"installationId":{"type":"string","pattern":"^[a-z0-9][a-z0-9_-]{0,63}$"},"entries":{"type":"array","maxItems":1024,"items":{"$ref":"#/$defs/entry"}}},"additionalProperties":false}},"allOf":[{"$ref":"common.json#/$defs/readOnlyEnvelope"},{"type":"object","properties":{"command":{"const":"history"},"data":{"oneOf":[{"$ref":"#/$defs/data"},{"type":"null"}]}},"allOf":[{"if":{"required":["status"],"properties":{"status":{"enum":["ok","no_change","degraded"]}}},"then":{"properties":{"data":{"$ref":"#/$defs/data"}}}}],"additionalProperties":true}]}
