{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alx4j/ai4j/schemas/v1/uninstall.json",
  "title": "AI4J schema v1 uninstall response",
  "$defs": {
    "planData": {"allOf": [{"$ref": "common.json#/$defs/planData"}, {"properties": {"operation": {"const": "uninstall"}}}]},
    "mutationData": {"allOf": [{"$ref": "common.json#/$defs/mutationData"}, {"properties": {"operation": {"const": "uninstall"}}}]}
  },
  "allOf": [
    {"$ref": "common.json#/$defs/baseEnvelope"},
    {"$ref": "common.json#/$defs/updateDispositionEnvelopeSemantics"},
    {"properties": {"command": {"const": "uninstall"}}},
    {"anyOf": [
      {"allOf": [
        {"$ref": "common.json#/$defs/readOnlyEnvelope"},
        {"$ref": "common.json#/$defs/planEnvelopeSemantics"},
        {"properties": {"data": {"oneOf": [{"$ref": "#/$defs/planData"}, {"type": "null"}]}}},
        {"if": {"properties": {"status": {"enum": ["ok", "no_change", "degraded"]}}}, "then": {"properties": {"data": {"$ref": "#/$defs/planData"}}}},
        {"if": {"properties": {"data": {"type": "null"}}}, "then": {"properties": {"status": {"enum": ["cancelled", "error"]}}}}
      ]},
      {"allOf": [
        {"$ref": "common.json#/$defs/mutationEnvelopeSemantics"},
        {"properties": {"data": {"oneOf": [{"$ref": "#/$defs/mutationData"}, {"type": "null"}]}}},
        {"if": {"properties": {"status": {"enum": ["ok", "no_change", "degraded"]}}}, "then": {"properties": {"data": {"$ref": "#/$defs/mutationData"}}}},
        {"if": {"properties": {"data": {"type": "null"}}}, "then": {"properties": {"status": {"enum": ["cancelled", "error"]}, "changed": {"const": false}, "exitCode": {"enum": [1, 2, 3, 4, 5, 6, 8, 9]}}}}
      ]}
    ]}
  ]
}
